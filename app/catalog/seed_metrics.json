    "denominator": "无（基础计数）",
    "eligible_dims": ["region", "family", "spec", "topic"],
    "additivity": "semi_additive",
    "requires_attribution": null
  },
  {
    "code": "sugar_documented_spec_ratio",
    "name": "有完整糖资料的可售规格占比",
    "owner": "商品部门",
    "kind": "derived",
