        "id": {
          "type": "string",
          "description": "记录的稳定编号"
        },
        "spec_id": {
          "type": "string",
          "description": "规格"
        },
        "region": {
          "type": "string",
          "description": "地区"
        },
        "date": {
          "type": "string",
          "description": "销售日"
        },
        "sellable": {
          "type": "boolean",
          "description": "明确可售状态"
