          "description": "销售使用的商品码"
        },
        "valid_from": {
          "type": "string",
          "description": "规格有效起日"
        },
        "valid_to": {
          "type": "string",
          "description": "有效结束日，不包含该日"
        },
        "package_g": {
          "type": "number",
          "description": "一件净质量克"
        }
      },
      "references": {}
    },
    "availability": {
      "description": "地区日可售情况，未列日期是无回报而非不可售",
